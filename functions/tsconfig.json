{
  "compilerOptions": {
    "module": "ESNext", // or "commonjs" if you use require
    "target": "ESNext",
    "moduleResolution": "node",
    "outDir": "./lib",
    // "module": "NodeNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    // "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    // "outDir": "lib",
    "sourceMap": true,
    "strict": true
    // "target": "es2017"
  },
  "compileOnSave": true,
  "include": ["src/**/*"]
}
